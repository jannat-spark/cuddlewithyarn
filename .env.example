# ---------------------------------------------------------------------------
# Cuddle With Yarn — environment
# Copy to `.env.local` and fill in. Every value is optional in development:
# without Supabase credentials the app runs on the local atelier store so the
# full shopping flow stays testable.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, Open Graph and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://cuddlewithyarn.com

# --- Supabase -------------------------------------------------------------
# Project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access ---------------------------------------------------------
# Email of the account allowed into /admin. Password is managed by Supabase Auth.
NEXT_PUBLIC_ADMIN_EMAIL=